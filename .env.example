# Скопируйте в .env и заполните реальными значениями (см. docs/USER_ACCOUNTS.md)

# Neon.tech: DATABASE_URL = Pooled, DIRECT_URL = Direct (для миграций)
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"
DIRECT_URL="postgresql://user:password@host/db?sslmode=require"

# Случайная строка для JWT (генерация: см. docs/USER_ACCOUNTS.md)
JWT_SECRET="change-me-please"

APP_URL="https://your-domain.com"
NEXT_PUBLIC_APP_URL="https://your-domain.com"

# Stripe: тестовые ключи sk_test_... / whsec_test_...
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# OpenAI: sk-... (модель по умолчанию gpt-4o-mini)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
